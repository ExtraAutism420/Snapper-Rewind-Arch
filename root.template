# subvolume to snapshot
SUBVOLUME="/"

# filesystem type
FSTYPE="btrfs"

# users/groups allowed to use snapshots
ALLOW_USERS=""
ALLOW_GROUPS=""

# create hourly snapshots
TIMELINE_CREATE="no"

# cleanup hourly snapshots
TIMELINE_CLEANUP="no"

# number of hourly snapshots to keep
TIMELINE_LIMIT_HOURLY="3"
TIMELINE_LIMIT_DAILY="3"
TIMELINE_LIMIT_WEEKLY="3"
TIMELINE_LIMIT_MONTHLY="3"
TIMELINE_LIMIT_QUARTERLY="3"
TIMELINE_LIMIT_YEARLY="3"

# cleanup algorithms
NUMBER_CLEANUP="yes"
NUMBER_LIMIT="3"
NUMBER_LIMIT_IMPORTANT="3"

# snapshot directory
SNAPSHOT_DIR="/.snapshots"

# exclude from snapshots
EXCLUDE="/.snapshots"
