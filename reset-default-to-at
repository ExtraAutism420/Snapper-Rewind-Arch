#!/bin/bash
# reset-default-to-at - Sync entire snapshot to @ and reset default subvolume to ID 256

set -e

CURRENT_DEFAULT=$(btrfs subvolume get-default / | awk '{print $2}')

if [ "$CURRENT_DEFAULT" -eq 256 ]; then
    echo "✅ Default already set to 256 — no action needed"
    exit 0
fi

echo "⚠️  Default subvolume is $CURRENT_DEFAULT — syncing snapshot to @ and resetting to 256"

# Mount the root subvolume (@)
MOUNT_POINT="/mnt/root_subvol"
mkdir -p "$MOUNT_POINT"
if ! mount -t btrfs -o subvolid=256 /dev/mapper/root "$MOUNT_POINT"; then
    echo "❌ ERROR: Failed to mount root subvolume"
    exit 1
fi

# Sync the entire snapshot to @, excluding system and transient directories
echo "📦 Syncing snapshot to @ (this may take a while)..."
rsync -aAXv --delete \
    --exclude={"/proc/*","/sys/*","/dev/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found","/var/cache/pacman/pkg/*"} \
    / "$MOUNT_POINT/"

# Unmount
umount "$MOUNT_POINT"
rmdir "$MOUNT_POINT"

echo "✅ Snapshot synced to @ (ID 256)"

# Reset the default subvolume
btrfs subvolume set-default 256 /
echo "✅ Default subvolume reset to @ (ID 256)"

# Interactive reboot prompt (only if running in a terminal)
if [ -t 0 ] && [ -t 1 ]; then
    echo "Do you want to reboot now to apply the change? (y/N): "
    read -t 30 USER_INPUT

    if [ -z "$USER_INPUT" ]; then
        echo "⏳ No input received within 30 seconds — skipping reboot."
        echo "The default subvolume has been reset. Reboot when ready."
    elif [[ "$USER_INPUT" =~ ^[Yy]$ ]]; then
        echo "🔄 Rebooting in 2 seconds..."
        sleep 2
        systemctl reboot
    else
        echo "❌ Skipping reboot. Default reset will apply on next reboot."
    fi
else
    echo "⏳ Running in non‑interactive mode — resetting default without reboot."
    echo "Default will be applied on next manual reboot."
fi
